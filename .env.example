# Server Configuration
PORT=3301
HOST=0.0.0.0

# Serper.dev API Key (for Google Search & News Search tools)
# Get your API key at: https://serper.dev
SERPER_API_KEY=your_serper_api_key_here

# Obsidian Local REST API Configuration — Target 'lera' (default)
# Default URL if not set: http://obsidian:27124
OBSIDIAN_BASE_URL=http://obsidian:27124
OBSIDIAN_API_KEY=your_obsidian_lera_api_key_here

# Obsidian Local REST API Configuration — Target 'lena' (secondary vault)
# Default URL if not set: http://obsidian-lena:27124
OBSIDIAN_LENA_BASE_URL=http://obsidian-lena:27124
OBSIDIAN_LENA_API_KEY=your_obsidian_lena_api_key_here

# Optional: Add other API keys below as you add new tool plugins in src/tools/
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
